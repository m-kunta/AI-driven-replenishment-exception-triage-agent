  "properties": {
    "urgency": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
